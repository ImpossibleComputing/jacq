+                start_seq_len=seq_len,
+                num_new=take,
+                scratch_start=prev_residual_len,
+                age_out_page=logical_page,
+                post_shift_residual_len=post_shift_residual_len,
+            )
+        )
+        seq_len = new_seq_len
+        remaining -= take
